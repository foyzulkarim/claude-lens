{
  "name": "@foyzulkarim/claude-lens",
  "version": "0.0.0",
  "description": "Local-first observability dashboard for Claude Code sessions.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "claude-lens": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "typecheck": "tsc --noEmit -p shared/tsconfig.json && tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p client/tsconfig.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "dev": "tsx watch server/cli.ts --port 4128 --no-open & vite --config client/vite.config.ts",
    "dev:server": "tsx watch server/cli.ts --port 4128 --no-open",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "tsx scripts/build.ts",
    "start": "node dist/cli.js",
    "storybook": "storybook dev -p 6006 -c client/.storybook",
    "build-storybook": "storybook build -c client/.storybook -o client/storybook-static",
    "bench:ingest": "tsx server/ingest/benchmark.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@fastify/static": "^9.3.0",
    "@fastify/websocket": "^11.3.0",
    "fast-glob": "^3.3.3",
    "fastify": "^5.10.0",
    "open": "^11.0.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.5.3",
    "@storybook/addon-themes": "^10.5.0",
    "@storybook/react-vite": "^10.5.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "minisearch": "^7.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.5.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wouter": "^3.10.0"
  }
}
